# Supabase project (public anon key only — never service_role)
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_KEY_HERE

# Cloudflare Worker that serves the server-side weather advisory (Phase 6).
# The worker holds the service-role secret; this URL is public.
VITE_WEATHER_WORKER_URL=https://sentinel-weather.YOUR_SUBDOMAIN.workers.dev
